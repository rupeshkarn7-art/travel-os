# Copy to .env and fill in your Supabase project values
# (Supabase → Project Settings → API Keys). The publishable key is safe for client apps.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_ENABLE_GOOGLE=false
EXPO_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com

{
  "expo": {
    "name": "Travel OS",
    "slug": "travel-os",
    "scheme": "travelos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1769E0"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.travelos.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.travelos.app",
      "adaptiveIcon": {
        "backgroundColor": "#1769E0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "versionCode": 1,
      "blockedPermissions": []
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Travel OS uses your photos so you can set a profile picture."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1769E0"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": ""
      }
    },
    "experiments": {
      "baseUrl": "/travel-os"
    }
  }
}
